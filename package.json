{
  "name": "canvas-inspector",
  "version": "0.2.0",
  "type": "module",
  "description": "A zero-dependency Canvas 2D draw-call inspector.",
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run types",
    "types": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./panel": {
      "types": "./dist/panel.d.ts",
      "import": "./dist/panel.js"
    },
    "./panel.css": "./dist/panel.css",
    "./auto": {
      "types": "./dist/auto.d.ts",
      "import": "./dist/auto.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "latest",
    "vite": "^8.3.4"
  }
}
